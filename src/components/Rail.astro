---
---

<aside class="rail" transition:persist>
	<div class="rail-top">
		<a class="wordmark" href="/">alex</a>
		<p class="tagline mono">crafter · tinkerer · woodworker · engineer</p>
	</div>
	<nav class="rail-nav">
		<a href="/#work" class="mono">work</a>
		<a href="/#about" class="mono">about</a>
		<a href="/tools" class="mono">tools</a>
		<a href="/#contact" class="mono">contact</a>
	</nav>
	<div class="rail-foot">
		<button id="theme-toggle" class="mono" type="button">light / dark</button>
		<p class="mono">made with coffee<br />© 2026</p>
	</div>
</aside>

<style>
	.rail {
		position: sticky;
		top: 0;
		height: 100vh;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: 2rem 1.75rem;
		border-right: 1px solid var(--line);
		background: color-mix(in srgb, var(--sage) 10%, var(--paper));
	}

	.wordmark {
		display: inline-block;
		font-family: 'Fraunces Variable', Georgia, serif;
		font-weight: 560;
		font-variation-settings: 'WONK' 1;
		font-size: 1.7rem;
		color: var(--green);
		text-decoration: none;
		margin: 0 0 0.6rem;
	}

	.tagline {
		margin: 0;
		font-size: 0.75rem;
		line-height: 1.8;
	}

	.rail-nav {
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
	}

	.rail-nav a {
		color: var(--ink);
		text-decoration: none;
		width: fit-content;
		border-bottom: 1px solid transparent;
	}

	.rail-nav a:hover {
		color: var(--green);
		border-color: var(--green);
	}

	.rail-foot {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		align-items: flex-start;
	}

	.rail-foot p {
		margin: 0;
		font-size: 0.65rem;
		line-height: 1.8;
	}


	#theme-toggle {
		font-size: 0.65rem;
		padding: 0.35rem 0.9rem;
		border: 1px solid var(--ink-soft);
		border-radius: 999px;
		background: none;
		color: var(--ink);
		cursor: pointer;
	}

	#theme-toggle:hover {
		border-color: var(--green);
		color: var(--green);
	}

	@media (max-width: 900px) {
		.rail {
			position: sticky;
			height: auto;
			flex-direction: row;
			align-items: center;
			gap: 1.5rem;
			padding: 0.9rem 1.5rem;
			border-right: none;
			border-bottom: 1px solid var(--line);
			border-top: 4px solid var(--green);
			z-index: 10;
		}
		.rail-nav {
			flex-direction: row;
			gap: 1.25rem;
			margin-left: auto;
		}
		.rail-foot {
			margin-left: auto;
		}
		.rail-foot p {
			display: none;
		}
		.tagline {
			display: none;
		}
	}
</style>

